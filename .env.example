# Copy this file to .env and fill in real values. Never commit .env itself.

# Runtime environment: development | test | production
ENVIRONMENT=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Directory containing the locally-supplied assessment data pack.
# See data/README.md for expected layout.
DATA_DIR=data

# Directory for generated/build artifacts (SQLite DB, document index cache).
# Rebuilt by the ingestion pipeline; safe to delete at any time.
VAR_DIR=var

# Anthropic API key, required once the LLM/agent layer exists (Milestone 5+).
# Leave unset for milestones that don't call the model.
ANTHROPIC_API_KEY=
